{
  "name": "@anyproto/anytype-mcp",
  "mcpName": "io.github.anyproto/anytype-mcp",
  "keywords": [
    "anytype",
    "api",
    "mcp",
    "server"
  ],
  "version": "2.0.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:dev": "vitest watch",
    "build": "tsc -build && node scripts/build-cli.js",
    "dev": "tsx watch scripts/start-server.ts",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "anytype-mcp": "bin/cli.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "26.6.6",
    "@types/which": "3.0.4",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.1"
  },
  "description": "Official MCP server for Anytype: a stdio bridge to the MCP server built into Anytype",
  "repository": {
    "type": "git",
    "url": "https://github.com/anyproto/anytype-mcp.git"
  },
  "author": "@anyproto",
  "bugs": {
    "url": "https://github.com/anyproto/anytype-mcp/issues"
  },
  "homepage": "https://github.com/anyproto/anytype-mcp#readme"
}
